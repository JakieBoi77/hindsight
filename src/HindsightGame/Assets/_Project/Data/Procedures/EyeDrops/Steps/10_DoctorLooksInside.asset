  m_Script: {fileID: 11500000, guid: 09dab4369ac763a44bd5ce97b0a28b06, type: 3}
  m_Name: 10_DoctorLooksInside
  m_EditorClassIdentifier: Hindsight.Runtime::Hindsight.Procedures.Steps.ExamineStepDefinition
  viewPrefab: {fileID: 5248993185354131157, guid: b81d24448c954c347b1525a64e893aab, type: 3}
  introLines:
  - text: The drops need some time to work, so we wait a little while.
    pose: 0
    narration: {fileID: 0}
  - text: Now I'll look inside your eye with my special light.
    pose: 2
    narration: {fileID: 0}
  holdPrompt:
    text: The light is bright, but it won't hurt. Hold the button and stay still!
    pose: 0
    narration: {fileID: 0}
  holdSeconds: 3
  interruptedLine:
    text: Oops! Let's stay still a little longer. Try again!
    pose: 0
    narration: {fileID: 0}
  successLines:
  - text: All done! I could see inside your eye. Great job staying still!
    pose: 3
    narration: {fileID: 0}
  tapToolPrompt:
    text: Tap my light to turn it on!
    pose: 2
    narration: {fileID: 0}
