  tapPrompt:
    text: Tap the eye drop bottle to see what the drops do!
    pose: 2
    narration: {fileID: 0}
  explanationLines:
  - text: Look! The black circle in the middle of your eye got bigger. It's called your pupil.
    pose: 3
    narration: {fileID: 0}
  - text: A bigger pupil is like opening a window, so I can see inside.
    pose: 0
    narration: {fileID: 0}
  - text: Afterwards, things may look blurry and extra bright for a few hours. Sunglasses can help!
    pose: 0
    narration: {fileID: 0}
  startPupilScale: 0.4
  endPupilScale: 0.85
  dilationSeconds: 2.5
