  viewPrefab: {fileID: 3956199038986421379, guid: 35772d9dfe3d8ff49825ec6b1ce3017e, type: 3}
  question:
    text: What is your job when the drops go in?
    pose: 2
    narration: {fileID: 0}
  answers:
  - text: Squeeze your eyes shut
    icon: {fileID: 3286163911610860551, guid: 15119b8da02c5ca4191cffcf1bc857b8, type: 3}
  - text: Head back, eyes open
    icon: {fileID: 3286163911610860551, guid: 8bc4da91a7a9167479d27421e041f38a, type: 3}
  - text: Wiggle and look around
    icon: {fileID: 3286163911610860551, guid: 5e8134c2d52235c41bf49820bfce547c, type: 3}
  correctIndex: 1
  tryAgainLine:
    text: Good try! Think about keeping your eyes nice and open.
    pose: 0
    narration: {fileID: 0}
  correctLine:
    text: That's right! Head back and eyes wide open. You've got this!
    pose: 3
    narration: {fileID: 0}
