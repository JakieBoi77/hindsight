  lines:
  - text: These are special eye drops.
    pose: 2
    narration: {fileID: 0}
  - text: They help me see all the way inside your eyes, so I can check that they're healthy.
    pose: 0
    narration: {fileID: 0}
  - text: 'Your job is easy: tilt your head back and keep your eyes open.'
    pose: 0
    narration: {fileID: 0}
